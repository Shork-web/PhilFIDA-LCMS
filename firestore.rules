rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isHRAdmin() {
      return isAuthenticated() && 
        (getUserData().roleId == 'role_hradmin' || getUserData().roleId == 'role_superadmin');
    }

    function isSupervisor() {
      return isAuthenticated() && 
        (getUserData().roleId == 'role_supervisor' || isHRAdmin());
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().roleId == 'role_superadmin';
    }

    // Employees Collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated() && (isSupervisor() || getUserData().employeeId == employeeId);
      allow write: if isHRAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isHRAdmin() || request.auth.uid == userId);
      allow write: if isSuperAdmin();
    }

    // Roles Collection
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Leave Types Collection
    match /leaveTypes/{leaveTypeId} {
      allow read: if isAuthenticated();
      allow write: if isHRAdmin();
    }

    // Leave Balances Collection
    match /leaveBalances/{balanceId} {
      allow read: if isAuthenticated() && (isHRAdmin() || resource.data.employeeId == getUserData().employeeId);
      allow write: if isHRAdmin();
    }

    // Leave Transactions Collection (Immutable Banking Ledger)
    match /leaveTransactions/{transactionId} {
      allow read: if isAuthenticated() && (isHRAdmin() || resource.data.employeeId == getUserData().employeeId);
      allow create: if isHRAdmin();
      allow update, delete: if false;
    }

    // Leave Applications Collection
    match /leaveApplications/{applicationId} {
      allow read: if isAuthenticated() && (isSupervisor() || resource.data.employeeId == getUserData().employeeId);
      allow create: if isAuthenticated() && request.resource.data.employeeId == getUserData().employeeId;
      allow update: if isSupervisor() || isHRAdmin() || (resource.data.employeeId == getUserData().employeeId && request.resource.data.status == 'Cancelled');
      allow delete: if false;
    }

    // CTO Requests Collection
    match /ctoRequests/{ctoId} {
      allow read: if isAuthenticated() && (isSupervisor() || resource.data.employeeId == getUserData().employeeId);
      allow create: if isAuthenticated() && request.resource.data.employeeId == getUserData().employeeId;
      allow update: if isSupervisor() || isHRAdmin();
      allow delete: if false;
    }

    // Leave Adjustments Collection
    match /leaveAdjustments/{adjustmentId} {
      allow read: if isHRAdmin();
      allow create: if isHRAdmin();
      allow update, delete: if false;
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isHRAdmin();
      allow delete: if isHRAdmin();
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isHRAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // System Settings Collection
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Holidays Collection
    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isHRAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isHRAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isHRAdmin();
    }

    // Monthly Accrual Logs Collection
    match /monthlyAccrualLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isHRAdmin();
      allow update, delete: if false;
    }

    // Generated Reports Collection
    match /generatedReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isHRAdmin();
    }
  }
}
