// PhilFIDA Leave Credit Management System (PLCMS) — Firebase Firestore Security Rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get current user document from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isHRAdmin() {
      return isAuthenticated() && 
        (getUserData().roleId == 'role_hradmin' || getUserData().roleId == 'role_superadmin');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().roleId == 'role_superadmin';
    }

    // Default Rule: Require Firebase Authentication for all document reads & writes
    // (Prevents the 'public database' security warning in Firebase Console)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Specific Collection Guards (Enforce strict backend role integrity)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isHRAdmin();
    }

    match /leaveTransactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isHRAdmin();
      allow update, delete: if false; // Immutable banking ledger
    }

    match /leaveApplications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
